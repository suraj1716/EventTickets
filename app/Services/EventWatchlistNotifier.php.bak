<?php

namespace App\Services;

use App\Jobs\SendEventWatchlistNotification;
use App\Models\Event;

class EventWatchlistNotifier
{
    /**
     * Send watchlist notifications.
     *
     * Normal notification:
     *   - verified subscribers only
     *   - only subscribers not previously notified
     *
     * Forced admin reminder:
     *   - verified subscribers only
     *   - sends to everyone verified, even if already notified
     */
    public function notify(Event $event, bool $force = false): int
    {
        $count = 0;

        $event->watchlist()
            ->whereNotNull('verified_at')
            ->when(
                !$force,
                fn ($query) => $query->where('notified', false)
            )
            ->chunkById(200, function ($chunk) use ($force, &$count) {
                foreach ($chunk as $entry) {
                    SendEventWatchlistNotification::dispatch($entry, $force);
                    $count++;
                }
            });

        return $count;
    }
}
